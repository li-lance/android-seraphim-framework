<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="origin"
        fetch="git@github.com:li-lance/" />
    <default revision="master"
        remote="origin"
        sync-j="4" />
<!--  Seraphim 多项目平台 · 共享逻辑 + 原生 UI
      顶层仓库 = 工作区编排（清单 + 文档）
      build/    = 平台级构建设施（所有项目共用）
      projects/ = 各项目独立子仓组，新项目在此追加           -->

    <!-- 平台级 -->
    <project name="build-logic.git" path="build-logic" revision="master" />

    <!-- 项目：DailyLog 每日任务 -->
    <project name="dailylog-shared.git" path="projects/dailylog/shared" revision="master" />
    <project name="dailylog-android.git" path="projects/dailylog/android" revision="master" />
    <project name="dailylog-ios.git" path="projects/dailylog/ios" revision="master" />
</manifest>
